      "markup": "class=\"\\{className\\} \\{type\\}\""
    },
    "kairos-app-header": "web-common/src/layout/header/Header.svelte",
    "kairos-logo-on-light": "web-common/src/layout/header/HeaderLogo.svelte",
    "kairos-logo-on-dark": "web-common/src/layout/header/HeaderLogo.svelte",
    "kairos-symbol-ink": "web-common/src/components/icons/RillLogoSquareNegative.svelte",
