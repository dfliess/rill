{
  "_comment": "Kairos Styles (kairos-cloud#242): every class a Style's CSS targets, and the component file that must keep it. Upstream renaming or dropping one fails scripts/style-guard.js on the sync, instead of a Style silently losing a rule. kairos-* classes are hooks Kairos added; the rest are upstream's own stable names. A hook is checked in the markup (class=\"…\" or class:name); `\"via\": \"style\"` checks a rule of the component's own <style> instead, for classes set from a prop (Button's variant), plus the `markup` pattern that sets them.",
  "hooks": {
    "component-card": "web-common/src/features/canvas/CanvasComponent.svelte",
    "component-header-container": "web-common/src/features/canvas/ComponentHeader.svelte",
    "title": "web-common/src/features/canvas/ComponentHeader.svelte",
    "big-number": "web-common/src/features/canvas/components/kpi/KPI.svelte",
    "agent-note": "web-common/src/features/canvas/components/agent-note/AgentNote.svelte",
    "suggested-prompt": "web-common/src/features/chat/core/suggested-prompts/SuggestedPrompts.svelte",
    "suggested-prompt-label": "web-common/src/features/chat/core/suggested-prompts/SuggestedPrompts.svelte",
    "tabs-container": "web-admin/src/features/projects/ProjectTabs.svelte",
    "chip": "web-common/src/components/chip/core/Chip.svelte",
    "time": {
      "file": "web-common/src/components/chip/core/Chip.svelte",
      "via": "style",
      "markup": "class=\"chip \\{type\\}\""
    },
    "primary": {
      "file": "web-common/src/components/button/Button.svelte",
      "via": "style",
      "markup": "class=\"\\{className\\} \\{type\\}\""
    },
