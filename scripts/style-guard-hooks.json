    "kairos-home-box-title": "web-admin/src/features/kairos-home/HomeBox.svelte",
    "secondary-destructive": {
      "file": "web-common/src/components/button/Button.svelte",
      "via": "style",
      "markup": "class=\"\\{className\\} \\{type\\}\""
    },
    "destructive": {
      "file": "web-common/src/components/button/Button.svelte",
      "via": "style",
      "markup": "class=\"\\{className\\} \\{type\\}\""
    },
    "neutral": {
