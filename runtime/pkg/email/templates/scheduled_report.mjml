<mjml>
  <mj-head>
    <mj-raw>
      <meta name="color-scheme" content="light" />
      <meta name="supported-color-schemes" content="light" />
    </mj-raw>
    <mj-preview>Tu informe ya está listo para ver.</mj-preview>
    <mj-font name="Source Sans 3" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600&display=swap" />
    <mj-font name="Inter Tight" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@600&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Source Sans 3', Arial, Helvetica, sans-serif" />
      <mj-text color="#3a3e42" font-size="16px" line-height="1.6" />
      <mj-button background-color="#2c53b0" color="#ffffff" font-family="'Inter Tight', 'Source Sans 3', Arial, sans-serif" font-weight="600" font-size="15px" border-radius="4px" inner-padding="13px 24px" align="left" />
    </mj-attributes>
    <mj-style>
      .hidden { display: none !important; }
      .summary { background-color: #f4f4f1; border-radius: 4px; border-left: 3px solid #2c53b0; }
      a { color: #2c53b0; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f1" width="560px">
    <mj-wrapper background-color="#fbfbf9" border="1px solid #dcdcd6" border-top="3px solid #2c53b0" border-radius="6px" padding="0">

      <mj-section padding="24px 32px" border-bottom="1px solid #dcdcd6">
        <mj-column>
          <mj-image align="left" width="143px" padding="0" src="https://kairosagentica.com/img/logo/kairos-lockup-horizontal-mono-azul.png" alt="Kairos" />
        </mj-column>
      </mj-section>

      <mj-section padding="32px">
        <mj-column>
          <mj-text font-family="'Inter Tight', 'Source Sans 3', Arial, sans-serif" font-size="12px" font-weight="600" letter-spacing="0.08em" color="#2c53b0" padding="0 0 6px 0">
            INFORME PROGRAMADO
          </mj-text>

          <mj-text font-family="'Inter Tight', 'Source Sans 3', Arial, sans-serif" font-size="20px" font-weight="600" color="#232528" letter-spacing="-0.018em" padding="0 0 12px 0">
            {{ .DisplayName }}
          </mj-text>

          <mj-text padding="0 0 20px 0">
            Tu informe de <b>{{ .ReportTimeString }}</b> ya está listo.
          </mj-text>

          <mj-text css-class="{{ if not .Summary }}hidden{{ end }} summary" font-size="14px" line-height="1.6" color="#3a3e42" padding="16px 18px">
            {{ .Summary }}
          </mj-text>
          <mj-spacer css-class="{{ if not .Summary }}hidden{{ end }}" height="20px" />

          <mj-button css-class="{{ if not .OpenLink }}hidden{{ end }}" href="{{ .OpenLink }}">
            {{ if .Summary }}Ver análisis completo{{ else }}Abrir en el navegador{{ end }}
          </mj-button>

          <mj-button css-class="{{ if not .DownloadLink }}hidden{{ end }}" background-color="#ffffff" color="#2c53b0" border="1px solid #dcdcd6" href="{{ .DownloadLink }}">
            Descargar archivo {{ .DownloadFormat }}
          </mj-button>

          <mj-text font-size="13px" line-height="1.5" color="#5b6065" padding="24px 0 0 0">
            {{ if .EditLink }}Para editar este informe, <a href="{{ .EditLink }}">haz clic aquí</a>. {{ end }}{{ if .UnsubscribeLink }}Para darte de baja de este informe, <a href="{{ .UnsubscribeLink }}">haz clic aquí</a>.{{ end }}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="20px 32px" border-top="1px solid #dcdcd6">
        <mj-column>
          <mj-text font-size="13px" line-height="1.5" color="#5b6065" padding="0">
            Kairos &middot; Inteligencia para empresas
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
  </mj-body>
</mjml>
